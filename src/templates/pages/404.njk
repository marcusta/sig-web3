{% extends "base.njk" %}

{% block title %}404 - Sidan hittades inte - Sweden Indoor Golf{% endblock %}

{% block content %}
<section class="flex-1 flex items-center justify-center py-20">
  <div class="text-center px-6">
    <h1 class="text-8xl font-black text-primary mb-4">404</h1>
    <h2 class="text-3xl font-bold text-white mb-4">Sidan hittades inte</h2>
    <p class="text-slate-400 mb-8 max-w-md mx-auto">Sidan du letar efter finns tyvärr inte. Den kan ha flyttats eller tagits bort.</p>
    <a href="{{ rootPath }}/" class="inline-block px-8 py-4 bg-primary text-slate-950 font-bold rounded-lg hover:bg-yellow-400 transition-colors">Tillbaka till startsidan</a>
  </div>
</section>
{% endblock %}
