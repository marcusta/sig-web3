{% extends "base.njk" %}

{% block title %}Hjälp Center - Sweden Indoor Golf{% endblock %}

{% block content %}
{% set pageTitle = "Hjälp Center" %}
{% set pageSubtitle = "Hur kan vi stå till tjänst?" %}
{% set pageBackground = rootPath + "/hero-bg.jpg" %}
{% include "partials/page-header.njk" %}

<section class="py-12 md:py-20 px-6">
  <div class="container mx-auto max-w-6xl">
    <div class="grid md:grid-cols-3 gap-8">

      {# Support #}
      <a href="{{ rootPath }}/support/" class="group">
        <div class="bg-slate-900 p-8 rounded-2xl border border-slate-800 h-full hover:border-primary/50 transition-all hover:bg-slate-800/80">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 text-primary group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          </div>
          <h2 class="text-2xl font-bold mb-3 group-hover:text-primary transition-colors">Support</h2>
          <p class="text-slate-400 mb-6">Behöver du komma i kontakt med oss? Skicka ett meddelande så hjälper vi dig så fort vi kan.</p>
          <span class="text-primary font-bold text-sm flex items-center gap-2">KONTAKTA OSS &rarr;</span>
        </div>
      </a>

      {# FAQ #}
      <a href="{{ rootPath }}/faq/" class="group">
        <div class="bg-slate-900 p-8 rounded-2xl border border-slate-800 h-full hover:border-primary/50 transition-all hover:bg-slate-800/80">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 text-primary group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
          </div>
          <h2 class="text-2xl font-bold mb-3 group-hover:text-primary transition-colors">Vanliga frågor</h2>
          <p class="text-slate-400 mb-6">Hitta svar på de vanligaste frågorna om bokning, utrustning, öppettider och mer.</p>
          <span class="text-primary font-bold text-sm flex items-center gap-2">LÄS FAQ &rarr;</span>
        </div>
      </a>

      {# Om oss #}
      <a href="{{ rootPath }}/om-oss/" class="group">
        <div class="bg-slate-900 p-8 rounded-2xl border border-slate-800 h-full hover:border-primary/50 transition-all hover:bg-slate-800/80">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 text-primary group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          </div>
          <h2 class="text-2xl font-bold mb-3 group-hover:text-primary transition-colors">Om oss</h2>
          <p class="text-slate-400 mb-6">Läs mer om Sweden Indoor Golf, vår vision och personerna bakom anläggningen.</p>
          <span class="text-primary font-bold text-sm flex items-center gap-2">LÄS MER &rarr;</span>
        </div>
      </a>

    </div>
  </div>
</section>
{% endblock %}
