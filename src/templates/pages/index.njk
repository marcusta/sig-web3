{% extends "base.njk" %}

{% block content %}
{# Hero Section #}
<section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-slate-950">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900/80 via-slate-900/70 to-slate-950/90"></div>
    <div class="absolute inset-0 opacity-30" style="background-image: url({{ rootPath }}/hero-bg.jpg); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_transparent_20%,_rgba(2,6,23,0.6)_70%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary/8 via-transparent to-transparent"></div>
  </div>

  <div class="container mx-auto px-4 md:px-6 relative z-10 text-center">
    <div class="space-y-6 max-w-4xl mx-auto">
      <h2 class="text-primary font-bold tracking-wider uppercase text-sm md:text-base hero-fade-in" style="animation-delay: 0.2s">
        Golf året runt på dina villkor
      </h2>

      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-white tracking-tight hero-scale-in" style="animation-delay: 0.4s">
        SPELA <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-yellow-200">GOLF!</span>
      </h1>

      <p class="text-slate-300 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto hero-fade-in" style="animation-delay: 0.6s">
        Du spelar med tourbollar i sval, vädersäker miljö och får exakt data på varje slag.
        Perfekt för dig som vill träna billigt, hålla spelet igång och spela när utomhustiderna är svåra att få.
      </p>

      <div class="pt-8 flex flex-col sm:flex-row gap-4 justify-center hero-fade-in" style="animation-delay: 0.8s">
        <a href="https://www.matchi.se/facilities/swedenindoorgolf" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-primary text-slate-950 text-lg font-bold rounded-lg hover:bg-yellow-400 transition-all transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2">
          BOKA SPELTID
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="{{ rootPath }}/prislista/" class="px-8 py-4 bg-slate-800 text-white text-lg font-bold rounded-lg hover:bg-slate-700 transition-all flex items-center justify-center">
          Se priser
        </a>
      </div>

      {# Trust chips #}
      <div class="pt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-slate-400 hero-fade-in" style="animation-delay: 1.2s">
        <span>8 simulatorbås</span>
        <span class="hidden sm:inline text-slate-600">&middot;</span>
        <span>Öppet 05–24</span>
        <span class="hidden sm:inline text-slate-600">&middot;</span>
        <span>Tourbollar & exakt slagdata</span>
        <span class="hidden sm:inline text-slate-600">&middot;</span>
        <span>Alla nivåer</span>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 w-full h-40 bg-gradient-to-t from-[#070c1a] to-transparent pointer-events-none"></div>
</section>

<section class="py-10 md:py-16 bg-[#070c1a]">
  <div class="container mx-auto px-4 md:px-6">
    {% include "partials/summer-offer.njk" %}
  </div>
</section>

{# Features Section #}
<section class="py-16 md:py-24 bg-[#070c1a]">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Utveckla din golf</h2>
      <div class="w-20 h-1 bg-primary mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {# Feature 1: Boka #}
      <div class="animate-on-scroll bg-slate-900/50 p-8 rounded-2xl border border-slate-800 hover:border-primary/50 transition-colors group text-center hover:-translate-y-2.5 duration-300">
        <div class="w-16 h-16 bg-slate-800 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors duration-300">
          <svg class="w-8 h-8 text-primary group-hover:text-slate-950 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-4">Boka hos MATCHi</h3>
        <p class="text-slate-400 mb-8 min-h-[3rem]">Vi använder MATCHi för alla våra bokningar. Enkelt och smidigt.</p>
        <a href="https://www.matchi.se/facilities/swedenindoorgolf" class="inline-block px-6 py-2 border border-slate-700 text-slate-300 font-semibold rounded-lg hover:bg-primary hover:border-primary hover:text-slate-950 transition-all">BOKA TID</a>
      </div>

      {# Feature 2: Öppettider #}
      <div class="animate-on-scroll delay-200 bg-slate-900/50 p-8 rounded-2xl border border-slate-800 hover:border-primary/50 transition-colors group text-center hover:-translate-y-2.5 duration-300">
        <div class="w-16 h-16 bg-slate-800 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors duration-300">
          <svg class="w-8 h-8 text-primary group-hover:text-slate-950 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-4">Öppettider 05-24</h3>
        <p class="text-slate-400 mb-8 min-h-[3rem]">Öppet varje dag. Få din kod vid bokning och spela när det passar dig.</p>
        <a href="{{ rootPath }}/oppettider/" class="inline-block px-6 py-2 border border-slate-700 text-slate-300 font-semibold rounded-lg hover:bg-primary hover:border-primary hover:text-slate-950 transition-all">MERA INFO</a>
      </div>

      {# Feature 3: Tävlingar #}
      <div class="animate-on-scroll delay-400 bg-slate-900/50 p-8 rounded-2xl border border-slate-800 hover:border-primary/50 transition-colors group text-center hover:-translate-y-2.5 duration-300">
        <div class="w-16 h-16 bg-slate-800 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:bg-primary transition-colors duration-300">
          <svg class="w-8 h-8 text-primary group-hover:text-slate-950 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-4">Tävlingar</h3>
        <p class="text-slate-400 mb-8 min-h-[3rem]">Vi arrangerar en mängd olika tävlingar under inomhus-säsongen.</p>
        <a href="{{ rootPath }}/tavlingar/" class="inline-block px-6 py-2 border border-slate-700 text-slate-300 font-semibold rounded-lg hover:bg-primary hover:border-primary hover:text-slate-950 transition-all">TÄVLA</a>
      </div>
    </div>
  </div>
</section>

{# Stats Section #}
<section class="py-12 md:py-20 bg-slate-900 border-y border-slate-800">
  <div class="container mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 divide-y md:divide-y-0 md:divide-x divide-slate-800">
      <div class="flex flex-col items-center justify-center p-8 text-center">
        <div class="text-5xl md:text-6xl font-black text-primary mb-2 animate-scale">
          <span data-counter="8">0</span>
        </div>
        <span class="text-slate-400 font-medium tracking-wider uppercase text-sm">Stationer</span>
      </div>
      <div class="flex flex-col items-center justify-center p-8 text-center">
        <div class="text-5xl md:text-6xl font-black text-primary mb-2 animate-scale delay-100">
          <span data-counter="2000">0</span>+
        </div>
        <span class="text-slate-400 font-medium tracking-wider uppercase text-sm">Banor</span>
      </div>
      <div class="flex flex-col items-center justify-center p-8 text-center">
        <div class="text-5xl md:text-6xl font-black text-primary mb-2 animate-scale delay-200">
          05-24
        </div>
        <span class="text-slate-400 font-medium tracking-wider uppercase text-sm">Öppet</span>
      </div>
    </div>
  </div>
</section>

{# Gallery Section #}
<section class="py-12 md:py-24 bg-slate-950">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Svårslagen miljö</h2>
      <div class="w-20 h-1 bg-primary mx-auto rounded-full"></div>
      <p class="text-slate-400 mt-4 max-w-2xl mx-auto">Våra lokaler är designade för att ge dig den bästa golfupplevelsen inomhus.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {% set galleryImages = ['gallery-1.jpg', 'gallery-2.jpg', 'gallery-3.jpg', 'hero-bg.jpg'] %}
      {% for img in galleryImages %}
      <div class="animate-on-scroll delay-{{ loop.index0 * 100 }} aspect-[4/3] bg-slate-800 rounded-xl overflow-hidden relative group gallery-img">
        <img src="{{ rootPath }}/{{ img }}" alt="Gallery image {{ loop.index }}" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500">
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# CTA Section #}
<section class="py-12 md:py-24 bg-primary relative overflow-hidden">
  <div class="absolute inset-0 bg-yellow-500 mix-blend-multiply opacity-50"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white/20 via-transparent to-transparent"></div>

  <div class="container mx-auto px-4 md:px-6 relative z-10 text-center">
    <div class="animate-scale">
      <h2 class="text-4xl md:text-5xl font-black text-slate-950 mb-6">TRÄNA SJÄLV ELLER UTMANA POLARNA</h2>
      <p class="text-slate-900 text-lg md:text-xl font-medium mb-10 max-w-2xl mx-auto">Du bokar enkelt din bana via MATCHi. Skapa ett konto och boka din första tid direkt.</p>
      <a href="https://www.matchi.se/facilities/swedenindoorgolf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 bg-slate-950 text-white text-lg font-bold rounded-lg hover:bg-slate-800 transition-all transform hover:scale-105 active:scale-95 shadow-xl">
        BOKA NU
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

{# Contact Form Section #}
{% include "partials/contact-form.njk" %}
{% endblock %}
