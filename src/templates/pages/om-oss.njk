{% extends "base.njk" %}

{% block title %}Om oss - Sweden Indoor Golf{% endblock %}

{% block content %}
{% set pageTitle = "Om oss" %}
{% set pageSubtitle = "Sweden Indoor Golf - Linköpings bästa inomhushall." %}
{% include "partials/page-header.njk" %}

<section class="py-12 md:py-16 bg-slate-950">
  <div class="container mx-auto px-4 md:px-6">
    <div class="max-w-4xl mx-auto space-y-8">

      {# Vision #}
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-white mb-4">Vår vision</h2>
        <p class="text-slate-300 leading-relaxed">Vi vill erbjuda den bästa tränings- och spelupplevelsen för golfare året runt. Med marknadens bästa simulatorer i en trivsam miljö skapar vi förutsättningar för både seriös träning och roligt spel med kompisarna.</p>
      </div>

      {# Facility #}
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-white mb-4">Anläggningen</h2>
        <p class="text-slate-300 leading-relaxed">Vår lokal på Industrigatan 5 är nyrenoverad och anpassad för inomhusgolf. Vi har rymliga bås, bra ventilation och en relaxavdelning där man kan ta en fika.</p>
      </div>

      {# How to find us #}
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <div class="flex items-start gap-4 mb-6">
          <div class="p-3 bg-primary/20 rounded-lg text-primary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Hitta till oss</h2>
        </div>
        <p class="text-slate-300 mb-6">Vi delar lokaler med PDL Alfa. Adressen är <span class="text-white font-semibold">Industrigatan 5</span>.</p>
        <div class="bg-slate-800/50 rounded-xl p-6 mb-6">
          <div class="flex items-start gap-3 mb-4">
            <svg class="w-5 h-5 text-primary mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
            <div>
              <h3 class="text-white font-semibold mb-1">Parkering</h3>
              <p class="text-slate-300 text-sm">När du parkerat anmäler du din registreringsskylt på en pekplatta precis innanför dörren och har då <span class="text-white font-semibold">3 timmar gratis parkering</span>.</p>
            </div>
          </div>
        </div>
        <a href="https://g.page/swedenindoorgolf?share" target="_blank" class="inline-flex items-center gap-2 bg-primary text-slate-900 px-4 py-2 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
          Öppna i Google Maps
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        </a>
      </div>

      {# Contact #}
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <div class="flex items-start gap-4 mb-6">
          <div class="p-3 bg-primary/20 rounded-lg text-primary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Kontakt</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6 mb-6">
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-slate-300">
              <svg class="w-[18px] h-[18px] text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Industrigatan 5, 582 77 Linköping</span>
            </div>
            <div class="flex items-center gap-3 text-slate-300">
              <svg class="w-[18px] h-[18px] text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>Matchi Booking: +46 10-405 88 00</span>
            </div>
            <div class="flex items-center gap-3 text-slate-300">
              <svg class="w-[18px] h-[18px] text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <a href="mailto:info@swedenindoorgolf.se" class="text-primary hover:underline">info@swedenindoorgolf.se</a>
            </div>
          </div>
        </div>
      </div>

      {# Contact persons #}
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <div class="flex items-start gap-4 mb-6">
          <div class="p-3 bg-primary/20 rounded-lg text-primary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h2 class="text-2xl font-bold text-white">Kontaktpersoner</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {% for person in contact.team %}
          <div class="bg-slate-800/50 rounded-xl p-6">
            <h3 class="text-white font-semibold text-lg mb-2">{{ person.name }}</h3>
            <a href="mailto:{{ person.email }}" class="text-primary hover:underline text-sm">{{ person.email }}</a>
          </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>
{% endblock %}
