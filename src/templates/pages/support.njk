{% extends "base.njk" %}

{% block title %}Support - Sweden Indoor Golf{% endblock %}

{% block content %}
{% set pageTitle = "Support" %}
{% set pageSubtitle = "Här hittar du snabbhjälp, manualer och kontaktuppgifter för teknisk support." %}
{% set pageBackground = rootPath + "/hero-bg.jpg" %}
{% include "partials/page-header.njk" %}

{# FAQ Quick Link Bar #}
<div class="py-6 bg-slate-900/50 border-b border-slate-800">
  <div class="container mx-auto px-4 md:px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-slate-300 text-sm md:text-base">
        Söker du information om <strong class="text-white">bokningar, priser eller medlemskap?</strong> Se vår <a href="{{ rootPath }}/faq/" class="text-primary hover:text-yellow-400 font-semibold underline">FAQ-sida</a>
      </p>
    </div>
  </div>
</div>

{# Main Section with Sidebar #}
<section class="py-12 md:py-20">
  <div class="container mx-auto px-4 md:px-6">
    <div class="flex flex-col lg:flex-row gap-12">

      {# Sidebar - Desktop only #}
      <aside class="hidden lg:block lg:w-1/3 xl:w-1/4">
        <div class="sticky top-24 space-y-2">
          <h3 class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-6 ml-4">Snabbnavigering</h3>
          <button class="support-nav-btn w-full flex items-center gap-4 px-4 py-3 rounded-xl transition-all bg-primary text-slate-950 font-bold shadow-lg shadow-primary/20" data-section="practice">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            <span>Träna på Rangen</span>
          </button>
          <button class="support-nav-btn w-full flex items-center gap-4 px-4 py-3 rounded-xl transition-all text-slate-400 hover:bg-slate-900 hover:text-white" data-section="play-round">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg>
            <span>Spela en Runda</span>
          </button>
          <button class="support-nav-btn w-full flex items-center gap-4 px-4 py-3 rounded-xl transition-all text-slate-400 hover:bg-slate-900 hover:text-white" data-section="compete">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            <span>Tävla & Utmaningar</span>
          </button>
          <button class="support-nav-btn w-full flex items-center gap-4 px-4 py-3 rounded-xl transition-all text-slate-400 hover:bg-slate-900 hover:text-white" data-section="troubleshooting">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            <span>Felsökning</span>
          </button>
          <button class="support-nav-btn w-full flex items-center gap-4 px-4 py-3 rounded-xl transition-all text-slate-400 hover:bg-slate-900 hover:text-white" data-section="understand-data">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M7 16h8"/><path d="M7 11h12"/><path d="M7 6h3"/></svg>
            <span>Förstå Data</span>
          </button>
          <button class="support-nav-btn w-full flex items-center gap-4 px-4 py-3 rounded-xl transition-all text-slate-400 hover:bg-slate-900 hover:text-white" data-section="advanced">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Avancerat</span>
          </button>
        </div>
      </aside>

      {# Main Content Area #}
      <main class="w-full lg:w-2/3 xl:w-3/4">

        {# Quick Link to Första Hjälpen #}
        <div class="mb-12 lg:mb-16">
          <a href="#troubleshooting" class="block w-full border-2 border-red-800/50 rounded-2xl p-4 md:p-8 hover:border-red-700 transition-all group bg-gradient-to-r from-red-950/30 to-slate-950">
            <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
              <svg class="w-9 h-9 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
              <div class="flex-1 text-center md:text-left">
                <h3 class="text-xl md:text-2xl font-bold text-white mb-1">Problem att komma igång?</h3>
                <p class="text-slate-300 text-sm md:text-base">Klicka här för att gå direkt till Första Hjälpen med lösningar på vanliga problem</p>
              </div>
              <div class="shrink-0 text-red-500 group-hover:translate-x-2 transition-transform hidden md:block">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </div>
            </div>
          </a>
        </div>

        {# ==================== TRÄNA PÅ RANGEN ==================== #}
        <section id="practice" class="mb-12 lg:mb-20 scroll-mt-24">
          <div class="mb-12 animate-on-scroll">
            <h2 class="text-4xl font-bold text-white mb-2">Träna på Rangen</h2>
            <p class="text-slate-400 text-lg">Kom igång med driving range och träningslägen</p>
          </div>

          {# Quick Start Video #}
          <div class="mb-16 animate-on-scroll">
            <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16"/></svg>
              Quick Start Video
            </h3>
            <div class="border border-slate-800 rounded-2xl overflow-hidden">
              <video controls class="w-full" poster="{{ rootPath }}/support/mat-1-2.jpg" preload="metadata" playsinline>
                <source src="{{ rootPath }}/support/sig-start.mp4" type="video/mp4">
                Din webbläsare stödjer inte videoformatet.
              </video>
            </div>
          </div>

          {# Slå ett slag #}
          <div class="mb-16 animate-on-scroll">
            <h3 class="text-2xl font-bold text-white mb-6">Slå ett slag</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3 text-slate-300 text-lg">
                <span class="w-2 h-2 bg-primary rounded-full mt-2 shrink-0"></span>
                Placera bollen, se Första hjälpen nedan
              </li>
              <li class="flex items-start gap-3 text-slate-300 text-lg">
                <span class="w-2 h-2 bg-primary rounded-full mt-2 shrink-0"></span>
                SLÅ och INGEN BOLL se Första hjälpen nedan
              </li>
              <li class="flex items-start gap-3 text-slate-300 text-lg">
                <span class="w-2 h-2 bg-primary rounded-full mt-2 shrink-0"></span>
                Sikta parallellt efter mattan som är placerad rakt mot duken
              </li>
            </ul>
          </div>

          {# Träningslägen #}
          <div class="animate-on-scroll">
            <h3 class="text-2xl font-bold text-white mb-6">Träningslägen</h3>
            <div class="space-y-8 md:space-y-0 md:grid md:grid-cols-3 md:gap-12">
              <div class="animate-on-scroll animate-from-left">
                <h4 class="font-bold text-white text-lg mb-3">Driving Range</h4>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2 text-slate-400">
                    <span class="w-1.5 h-1.5 bg-primary rounded-full mt-2 shrink-0"></span>
                    Välj olika målflaggor genom att klicka på dem eller ändra avståndet manuellt.
                  </li>
                  <li class="flex items-start gap-2 text-slate-400">
                    <span class="w-1.5 h-1.5 bg-primary rounded-full mt-2 shrink-0"></span>
                    Se din slagstatistik i listform för att identifiera mönster i din träning.
                  </li>
                </ul>
              </div>
              <div class="animate-on-scroll animate-from-left">
                <h4 class="font-bold text-white text-lg mb-3">Practice on Course</h4>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2 text-slate-400">
                    <span class="w-1.5 h-1.5 bg-primary rounded-full mt-2 shrink-0"></span>
                    Gör det möjligt att träna på specifika slag var som helst på en bana.
                  </li>
                  <li class="flex items-start gap-2 text-slate-400">
                    <span class="w-1.5 h-1.5 bg-primary rounded-full mt-2 shrink-0"></span>
                    Byt hål: Hoppa mellan olika hål för att träna specifika situationer.
                  </li>
                  <li class="flex items-start gap-2 text-slate-400">
                    <span class="w-1.5 h-1.5 bg-primary rounded-full mt-2 shrink-0"></span>
                    Flytta bollen: Klicka på marken eller kartan för att placera bollen precis där du vill träna.
                  </li>
                </ul>
              </div>
              <div class="animate-on-scroll animate-from-left">
                <h4 class="font-bold text-white text-lg mb-3">Skills Challenge</h4>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2 text-slate-400">
                    <span class="w-1.5 h-1.5 bg-primary rounded-full mt-2 shrink-0"></span>
                    Utmana dig själv i precisionsövningar mot flaggan.
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        {# ==================== SPELA EN RUNDA ==================== #}
        <section id="play-round" class="mb-12 lg:mb-20 p-6 md:p-8 bg-slate-900/30 rounded-2xl scroll-mt-24">
          <div class="mb-12 animate-on-scroll">
            <h2 class="text-4xl font-bold text-white mb-2">Spela en Runda</h2>
            <p class="text-slate-400 text-lg">Allt du behöver veta för att spela en hel bana</p>
          </div>

          {# Spelare - Lägga till/Ta bort #}
          <div class="mb-12 animate-on-scroll">
            <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              Spelare - Lägga till/Ta bort
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
              <div class="animate-on-scroll animate-from-left">
                <h4 class="font-bold text-white text-lg mb-2">Lägg till spelare</h4>
                <p class="text-slate-400 leading-relaxed">Tryck på "+"-knappen i nedre vänstra hörnet av menyn "Players Settings". Du kan lägga till upp till 8 lokala spelare.</p>
              </div>
              <div class="animate-on-scroll animate-from-left">
                <h4 class="font-bold text-white text-lg mb-2">Ta bort spelare</h4>
                <p class="text-slate-400 leading-relaxed">Använd "X" eller minus-ikonen vid spelarprofilen i listan.</p>
              </div>
              <div class="animate-on-scroll animate-from-left">
                <h4 class="font-bold text-white text-lg mb-2">Höger/Vänster</h4>
                <p class="text-slate-400 leading-relaxed">För varje spelare kan du välja om de spelar höger- eller vänsterhänt. På bana 3 (vår multiswipe-bana) är detta extra viktigt för att launch monitorn ska läsa rätt.</p>
              </div>
              <div class="animate-on-scroll animate-from-left">
                <h4 class="font-bold text-white text-lg mb-2">Turordning</h4>
                <p class="text-slate-400 leading-relaxed">En stjärna (*) bredvid ett namn i spelarlistan betyder att spelaren redan har slagit sitt slag. Du kan klicka på valfritt namn i listan för att hoppa till den spelarens tur.</p>
              </div>
            </div>
          </div>

          {# Starta en runda #}
          <div class="mb-12 animate-on-scroll">
            <h3 class="text-2xl font-bold text-white mb-6">Starta en runda</h3>
            <div class="space-y-8">
              <div class="flex items-start gap-4 animate-on-scroll animate-from-left">
                <div class="text-primary font-bold shrink-0 text-2xl">1.</div>
                <div class="flex-1">
                  <h4 class="font-bold text-white text-lg mb-2">Välj Bana</h4>
                  <p class="text-slate-400 leading-relaxed">Bläddra genom biblioteket av världsberömda banor.</p>
                </div>
              </div>
              <div class="flex items-start gap-4 animate-on-scroll animate-from-left">
                <div class="text-primary font-bold shrink-0 text-2xl">2.</div>
                <div class="flex-1">
                  <h4 class="font-bold text-white text-lg mb-2">Matchinställningar</h4>
                  <ul class="space-y-2 mt-3">
                    <li class="text-slate-400 leading-relaxed">
                      <span class="text-primary font-semibold">Tee:</span> Välj tee baserat på din önskade svårighetsgrad/längd.
                    </li>
                    <li class="text-slate-400 leading-relaxed">
                      <span class="text-primary font-semibold">Puttning:</span> Välj mellan Auto-putt (datorn avgör baserat på avstånd), Gimme circle (hålet räknas som sänkt inom en viss radie, t.ex. 2-3 meter), eller Manuell puttning.
                    </li>
                  </ul>
                </div>
              </div>
              <div class="flex items-start gap-4 animate-on-scroll animate-from-left">
                <div class="text-primary font-bold shrink-0 text-2xl">3.</div>
                <div class="flex-1">
                  <h4 class="font-bold text-white text-lg mb-2">Mulligans</h4>
                  <p class="text-slate-400 leading-relaxed">Kan aktiveras i inställningarna om man vill kunna ta om ett slag (använd CTRL + M).</p>
                </div>
              </div>
              <div class="flex items-start gap-4 animate-on-scroll animate-from-left">
                <div class="text-primary font-bold shrink-0 text-2xl">4.</div>
                <div class="flex-1">
                  <h4 class="font-bold text-white text-lg mb-2">Väder & Förhållanden</h4>
                  <p class="text-slate-400 leading-relaxed">Du kan ställa in vindstyrka, hårdhet på fairways och hastighet på greenerna (Stimp).</p>
                </div>
              </div>
            </div>
          </div>

          {# Under spelet - Kontroller #}
          <div class="animate-on-scroll">
            <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="M6 8h.001"/><path d="M10 8h.001"/><path d="M14 8h.001"/><path d="M18 8h.001"/><path d="M8 12h.001"/><path d="M12 12h.001"/><path d="M16 12h.001"/><path d="M7 16h10"/></svg>
              Under spelet - Kontroller
            </h3>
            <div class="space-y-8 mb-12">
              {# Genvägar (Viktigt!) #}
              <div>
                <h4 class="text-lg font-bold text-white mb-4">Genvägar (Viktigt!)</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">TAB</kbd>
                    <span class="text-slate-400 text-sm">Se en fullständig lista över alla tangentbordsgenvägar direkt på skärmen.</span>
                  </div>
                </div>
              </div>

              {# Sikta & Kamera #}
              <div>
                <h4 class="text-lg font-bold text-white mb-4">Sikta & Kamera</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">A</kbd>
                    <span class="text-slate-400 text-sm">Återställ siktet mot det rekommenderade målet.</span>
                  </div>
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">F3</kbd>
                    <span class="text-slate-400 text-sm">Växla mellan boll, siktpunkt och hålet.</span>
                  </div>
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">F5</kbd>
                    <span class="text-slate-400 text-sm">Free Look - flyga fritt (använd W/A/S/D + högerklick).</span>
                  </div>
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">R</kbd>
                    <span class="text-slate-400 text-sm">Öppna "Range Finder" (avståndsmätare).</span>
                  </div>
                </div>
              </div>

              {# Minikartan #}
              <div>
                <h4 class="text-lg font-bold text-white mb-4">Minikartan</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">Q</kbd>
                    <span class="text-slate-400 text-sm">Zooma in på minikartan.</span>
                  </div>
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">W</kbd>
                    <span class="text-slate-400 text-sm">Zooma ut på minikartan.</span>
                  </div>
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">S</kbd>
                    <span class="text-slate-400 text-sm">Ändra storlek på kartan.</span>
                  </div>
                  <div class="flex items-center gap-4 bg-slate-900/50 border border-slate-800 rounded-xl p-4 hover:border-primary/30 transition-colors">
                    <kbd class="px-3 py-2 bg-slate-800 rounded-lg text-primary font-mono font-bold text-sm min-w-[60px] text-center">Y</kbd>
                    <span class="text-slate-400 text-sm">Se höjdkurvor (slope) på greenen (Heatmap).</span>
                  </div>
                </div>
              </div>
            </div>

            {# Lie & Påverkan #}
            <div class="mt-12 pt-12 border-t border-slate-800">
              <h4 class="text-xl font-bold text-white mb-4">Lie & Påverkan</h4>
              <p class="text-slate-400 mb-6">Information om hur bollen ligger finns längst ner på minikartan.</p>
              <div class="space-y-6">
                <div>
                  <h5 class="font-semibold text-primary text-lg mb-1">Uppför/Nedför</h5>
                  <p class="text-slate-400">Påverkar bollens höjd och längd.</p>
                </div>
                <div>
                  <h5 class="font-semibold text-primary text-lg mb-1">Sido-lutning</h5>
                  <p class="text-slate-400">Om det står "Left" betyder det att bollen ligger under fötterna och tenderar att starta åt vänster.</p>
                </div>
                <div>
                  <h5 class="font-semibold text-primary text-lg mb-1">Puttning</h5>
                  <p class="text-slate-400">Använd heatmap (Y) för att läsa greenen. Siktet justeras med musen eller piltangenterna.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        {# ==================== TÄVLA & UTMANINGAR ==================== #}
        <section id="compete" class="mb-12 lg:mb-20 scroll-mt-24">
          <div class="mb-12 animate-on-scroll">
