{% extends "base.njk" %}

{% block title %}Tävlingar - Sweden Indoor Golf{% endblock %}

{% block content %}
{% set pageTitle = "Tävlingar" %}
{% set pageSubtitle = "Utmana dig själv och andra i våra tävlingar." %}
{% set pageBackground = rootPath + "/hero-bg.jpg" %}
{% include "partials/page-header.njk" %}

{# HobbyTouren Indoor Section #}
<section class="py-12 md:py-16 bg-slate-950">
  <div class="container mx-auto px-4 md:px-6">
    <div class="max-w-4xl mx-auto">

      <div class="mb-16">
        <div class="flex items-start gap-4 mb-8">
          <svg class="w-8 h-8 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          <div>
            <h2 class="text-3xl font-bold text-white mb-2">{{ tournaments.hobbytouren.title }}</h2>
            <p class="text-primary font-semibold text-lg">{{ tournaments.hobbytouren.subtitle }}</p>
          </div>
        </div>

        {# Red callout #}
        <div class="border-l-4 border-red-500 pl-6 mb-8">
          <p class="text-white font-semibold text-lg">{{ tournaments.hobbytouren.callout }}</p>
        </div>

        <p class="text-slate-300 mb-8 text-lg leading-relaxed">{{ tournaments.hobbytouren.intro }}</p>

        {# Blue notice #}
        <div class="border-l-4 border-blue-500 pl-6 mb-10">
          <p class="text-blue-200 font-medium">{{ tournaments.hobbytouren.notice | safe }}</p>
        </div>

        {# PART 1: Registration (one-time) #}
        <div class="mb-12 pb-12 border-b border-slate-800">
          <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Registrering och anmälan (engångsregistrering)
          </h3>

          <h4 class="text-white font-semibold mb-3">Steg 1: Registrera dig på SimulatorGolfTour</h4>
          <ol class="list-decimal list-inside text-slate-300 space-y-2 mb-6 ml-2">
            {% for step in tournaments.hobbytouren.registration.steps %}
            <li>{{ step | safe }}</li>
            {% endfor %}
          </ol>

          {# Critical Info Box #}
          <div class="border-l-4 border-red-500 pl-6 mb-8 bg-red-950/20 py-4">
            <p class="text-red-200 font-bold mb-3">MYCKET VIKTIGT - Spara denna information:</p>
            <ul class="text-red-200 space-y-2">
              {% for info in tournaments.hobbytouren.registration.criticalInfo %}
              <li>{{ info | safe }}</li>
              {% endfor %}
            </ul>
          </div>

          <h4 class="text-white font-semibold mb-3">Steg 2: Anmäl dig till HobbyTouren</h4>
          <p class="text-slate-300 mb-4">
            Maila ditt <strong class="text-white">USERNAME</strong> till <a href="mailto:{{ tournaments.hobbytouren.registration.signupEmail }}" class="text-primary hover:underline">{{ tournaments.hobbytouren.registration.signupEmail }}</a> så blir du inlagd i tävlingen.
            Du måste vara registrerad hos Fredrik innan du kan spela.
          </p>

          <div class="flex flex-wrap gap-4">
            <a href="{{ tournaments.hobbytouren.registration.sgtRegisterUrl }}" target="_blank" class="inline-flex items-center gap-2 bg-primary text-slate-900 px-4 py-2 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
              Registrera dig på SGT
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            </a>
            <a href="{{ tournaments.hobbytouren.registration.sgtTourUrl }}" target="_blank" class="inline-flex items-center gap-2 bg-slate-700 text-white px-4 py-2 rounded-lg font-semibold hover:bg-slate-600 transition-colors">
              Se HobbyTouren
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            </a>
          </div>
        </div>

        {# PART 2: Playing (every time) #}
        <div class="mb-12 pb-12 border-b border-slate-800">
          <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            Spela tävling (görs varje gång du spelar)
          </h3>

          <h4 class="text-white font-semibold mb-3">Steg 1: Koppla ditt SGT-konto i GSPro</h4>
          <ol class="list-decimal list-inside text-slate-300 space-y-2 mb-6 ml-2">
            {% for step in tournaments.hobbytouren.playing.connectSteps %}
            <li>{{ step | safe }}</li>
            {% endfor %}
          </ol>

          <h4 class="text-white font-semibold mb-3">Steg 2: Starta tävlingen</h4>
          <ol class="list-decimal list-inside text-slate-300 space-y-2 mb-4 ml-2">
            {% for step in tournaments.hobbytouren.playing.startSteps %}
            <li>{{ step | safe }}</li>
            {% endfor %}
          </ol>
        </div>

        {# Classes and Fees #}
        <div class="grid md:grid-cols-2 gap-12 mb-12">
          <div>
            <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
              Klasser
            </h3>
            <div class="space-y-4">
              <div>
                <p class="text-white font-semibold text-lg">{{ tournaments.hobbytouren.classes.men | safe }}</p>
              </div>
              <div>
                <p class="text-white font-semibold text-lg">{{ tournaments.hobbytouren.classes.women | safe }}</p>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
              Anmälningsavgift
            </h3>
            <div class="space-y-4">
              <div>
                <div class="flex justify-between items-baseline mb-1">
                  <span class="text-slate-300 text-lg">Herrar</span>
                  <span class="text-white font-bold text-xl">{{ tournaments.hobbytouren.fees.men.amount }}</span>
                </div>
                {% if tournaments.hobbytouren.fees.men.note %}
                <p class="text-slate-500 text-sm">{{ tournaments.hobbytouren.fees.men.note }}</p>
                {% endif %}
              </div>
              <div>
                <div class="flex justify-between items-baseline">
                  <span class="text-slate-300 text-lg">Damer</span>
                  <span class="text-white font-bold text-xl">{{ tournaments.hobbytouren.fees.women.amount }}</span>
                </div>
              </div>
              <div class="pt-4 border-t border-slate-700">
                <p class="text-slate-400">
                  Swisha till Sweden Indoor Golf AB<br>
                  <span class="text-white font-mono text-lg">{{ tournaments.hobbytouren.fees.swish }}</span><br>
                  <span class="text-sm">Ange &quot;{{ tournaments.hobbytouren.fees.swishMessage }}&quot; som meddelande</span>
                </p>
              </div>
            </div>
          </div>
        </div>

        {# Trophies #}
        <div class="mb-12">
          <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            Vandringspokaler
          </h3>
          <div class="space-y-6">
            {% for trophy in tournaments.hobbytouren.trophies %}
            <div>
              <p class="text-white font-bold text-lg mb-1">{{ trophy.name }}</p>
              <p class="text-slate-400">{{ trophy.description }}</p>
            </div>
            {% endfor %}
          </div>
        </div>

        {# Troubleshooting #}
        <div>
          <h3 class="text-xl font-bold text-white mb-6">Vanliga problem</h3>
          <div class="space-y-6">
            {% for issue in tournaments.hobbytouren.troubleshooting %}
            <div>
              <p class="text-white font-semibold text-lg mb-2">{{ issue.title }}</p>
              {% if issue.intro %}
              <p class="text-slate-300 mb-2">{{ issue.intro }}</p>
              {% endif %}
              {% if issue.checklist %}
              <ul class="list-disc list-inside space-y-1 text-slate-300 ml-4">
                {% for item in issue.checklist %}
                <li>{{ item | safe }}</li>
                {% endfor %}
              </ul>
              {% endif %}
              {% if issue.text %}
              <p class="text-slate-300">{{ issue.text | safe }}</p>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {# H40+ Scratch Indoor Section #}
      <div class="pt-16 border-t-2 border-slate-800">
        <div class="flex items-start gap-4 mb-8">
          <svg class="w-8 h-8 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
          <div>
            <h2 class="text-3xl font-bold text-white mb-2">{{ tournaments.h40.title }}</h2>
            <p class="text-primary font-semibold text-lg">{{ tournaments.h40.subtitle }}</p>
          </div>
        </div>

        <p class="text-slate-300 mb-6">{{ tournaments.h40.description }}</p>

        {# Format #}
        <div class="mb-12">
          <h3 class="text-xl font-bold text-white mb-4">Format 2025-2026</h3>
          <ul class="text-slate-300 space-y-2 text-lg">
            {% for item in tournaments.h40.format %}
            <li>{{ item | safe }}</li>
            {% endfor %}
          </ul>
        </div>

        {# Simulator Instructions #}
        <div class="mb-12">
          <h3 class="text-lg font-bold text-white mb-4">Kort instruktion simulatorgolf</h3>
          <div class="space-y-4 text-slate-300">
            <p>{{ tournaments.h40.simulatorInstructions.putting }}</p>
            <p>{{ tournaments.h40.simulatorInstructions.stimp }}</p>

            <div>
              <p class="text-white font-semibold mb-2">Lie (läge på bollen)</p>
              <ul class="list-disc list-inside text-sm space-y-1">
                {% for lie in tournaments.h40.simulatorInstructions.lies %}
                <li><span class="text-white">{{ lie.name }}:</span> {{ lie.description }}</li>
                {% endfor %}
              </ul>
            </div>

            <div>
              <p class="text-white font-semibold mb-2">Lutning</p>
              <p class="text-sm">{{ tournaments.h40.simulatorInstructions.slope }}</p>
            </div>
          </div>
        </div>

        {# Schedule #}
        <div class="mb-12">
          <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
            Spelschema 2025-2026
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-slate-700">
                  <th class="text-left py-2 text-slate-400">Datum</th>
                  <th class="text-left py-2 text-slate-400">Bana</th>
                  <th class="text-left py-2 text-slate-400">Tid</th>
                  <th class="text-left py-2 text-slate-400">Info</th>
                </tr>
              </thead>
              <tbody class="text-slate-300">
                {% for row in tournaments.h40.schedule %}
                <tr class="{% if row.isFinal %}bg-primary/10{% else %}border-b border-slate-800{% endif %}">
                  <td class="py-2 {% if row.isFinal %}font-semibold text-primary{% endif %}">{{ row.date }}</td>
                  <td class="py-2 {% if row.isFinal %}font-semibold text-primary{% endif %}">{{ row.course }}</td>
                  <td class="py-2">{{ row.time }}</td>
                  <td class="py-2 {% if row.isFinal %}text-primary{% else %}text-slate-500{% endif %}">{{ row.info }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        {# Fee #}
        <div class="mb-12">
          <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            Avgift
          </h3>
          <p class="text-slate-300 mb-3">{{ tournaments.h40.fee.description }}</p>
          <p class="text-slate-400 text-sm mb-4">{{ tournaments.h40.fee.paymentInfo }}</p>
          <a href="{{ tournaments.h40.fee.paymentUrl }}" target="_blank" class="inline-flex items-center gap-2 bg-primary text-slate-900 px-4 py-2 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
            Betala via MATCHi
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          </a>
        </div>

        {# Registration #}
        <div class="mb-12">
          <h3 class="text-lg font-bold text-white mb-4">Anmälan</h3>
          <p class="text-slate-300">{{ tournaments.h40.registration.text | safe }}</p>
        </div>

        {# Contacts #}
        <div>
          <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Kontaktpersoner
          </h3>
          <div class="grid md:grid-cols-2 gap-6">
            {% for contact in tournaments.h40.contacts %}
            <div>
              <p class="text-white font-semibold">{{ contact.club }}</p>
              {% for person in contact.people %}
              {% if not loop.first %}<p class="text-slate-300 mt-1">{{ person.name }}</p>{% else %}<p class="text-slate-300">{{ person.name }}</p>{% endif %}
              <a href="mailto:{{ person.email }}" class="text-primary hover:underline text-sm">{{ person.email }}</a>
              {% if person.phone %}
              <p class="text-slate-400 text-sm">{{ person.phone }}</p>
              {% endif %}
              {% endfor %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
{% endblock %}
