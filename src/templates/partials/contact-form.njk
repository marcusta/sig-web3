{# Contact form partial - reused on home + kontakt pages #}
<section class="py-12 md:py-24 bg-slate-900">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Kontakta oss</h2>
      <div class="w-20 h-1 bg-primary mx-auto rounded-full"></div>
      <p class="text-slate-400 mt-4">Fyll i dina uppgifter nedan så hör vi av oss så fort som möjligt.</p>
    </div>

    <div class="max-w-2xl mx-auto bg-slate-950 p-8 md:p-12 rounded-2xl border border-slate-800 shadow-2xl">
      <form id="contact-form" class="space-y-6" data-action="https://app.swedenindoorgolf.se/sig-status/contact">
        <input type="text" name="_url" style="display:none" tabindex="-1" autocomplete="off">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-sm font-medium text-slate-300">Namn <span class="text-red-500">*</span></label>
            <input type="text" name="name" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
          </div>
          <div class="space-y-2">
            <label class="text-sm font-medium text-slate-300">Telefon</label>
            <input type="tel" name="phone" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
          </div>
        </div>

        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-300">Email <span class="text-red-500">*</span></label>
          <input type="email" name="email" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
        </div>

        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-300">Företag</label>
          <input type="text" name="company" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
        </div>

        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-300">Meddelande <span class="text-red-500">*</span></label>
          <textarea name="message" required rows="4" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-none"></textarea>
        </div>

        <div id="form-status" class="hidden text-center p-4 rounded-lg"></div>

        <button type="submit" class="w-full bg-primary text-slate-950 font-bold py-4 rounded-lg hover:bg-yellow-400 transition-all transform hover:scale-[1.02] active:scale-[0.98]">
          SKICKA MEDDELANDE
        </button>
      </form>
    </div>
  </div>
</section>
