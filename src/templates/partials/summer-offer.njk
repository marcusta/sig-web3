{% if pricing.summerOffer and pricing.summerOffer.enabled %}
<div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.1fr] gap-8 lg:gap-12 items-center">
  <div class="animate-on-scroll">
    <p class="text-primary font-bold tracking-wider uppercase text-sm mb-3">{{ pricing.summerOffer.eyebrow }}</p>
    <h2 class="text-4xl md:text-5xl font-black text-white tracking-tight mb-5">{{ pricing.summerOffer.title }}</h2>
    <p class="text-lg text-slate-300 leading-relaxed max-w-2xl">{{ pricing.summerOffer.description }}</p>
  </div>

  <div class="animate-scale bg-slate-900/70 border border-primary/30 rounded-2xl p-6 md:p-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <p class="text-slate-400 text-sm font-semibold uppercase tracking-wider mb-1">Boka under sommaren</p>
        <div class="flex items-baseline gap-3">
          <span class="text-6xl md:text-7xl font-black text-primary tracking-tight">{{ pricing.summerOffer.price }}</span>
          <span class="text-xl md:text-2xl font-bold text-white">{{ pricing.summerOffer.unit }}</span>
        </div>
      </div>
      <svg class="w-14 h-14 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2"/>
        <path d="M12 20v2"/>
        <path d="m4.93 4.93 1.41 1.41"/>
        <path d="m17.66 17.66 1.41 1.41"/>
        <path d="M2 12h2"/>
        <path d="M20 12h2"/>
        <path d="m6.34 17.66-1.41 1.41"/>
        <path d="m19.07 4.93-1.41 1.41"/>
      </svg>
    </div>

    <ul class="space-y-4 mb-8">
      {% for feature in pricing.summerOffer.features %}
      <li class="flex gap-3 text-slate-200">
        <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <span>{{ feature }}</span>
      </li>
      {% endfor %}
    </ul>

    <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
      <a href="https://www.matchi.se/facilities/swedenindoorgolf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-slate-950 font-bold rounded-lg hover:bg-yellow-400 transition-colors">
        BOKA VIA MATCHI
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <p class="text-sm text-slate-500">{{ pricing.summerOffer.note }}</p>
    </div>
  </div>
</div>
{% endif %}
